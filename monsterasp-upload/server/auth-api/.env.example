NODE_ENV=development
PORT=8090
API_VERSION=v1
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=

MONGODB_URI=mongodb://127.0.0.1:27017/levelup_auth

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ACCESS_COOKIE_NAME=levelup_access
REFRESH_COOKIE_NAME=levelup_refresh

BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=10

CSRF_ENABLED=false
CSRF_COOKIE_NAME=levelup_csrf
CSRF_HEADER_NAME=x-csrf-token

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LevelUp <no-reply@levelup.local>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_VIDEO_FOLDER=levelup/videos
CLOUDINARY_SIGNED_URL_TTL_SECONDS=900
CLOUDINARY_UPLOAD_CHUNK_SIZE_MB=20

UPLOAD_TEMP_DIR=tmp/uploads
MAX_VIDEO_SIZE_MB=1024
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
