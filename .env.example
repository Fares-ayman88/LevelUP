# Local LevelUp backend for development. On Vercel, leave this unset to use /api/levelup.
VITE_LEVELUP_API_URL=http://127.0.0.1:8080
VITE_GOOGLE_CLIENT_ID=713417674505-2653e24s70ode9kc97661ojp0gjl168s.apps.googleusercontent.com
VITE_LEVELUP_ENFORCE_EMAIL_VERIFICATION=false

# /api uses the Vercel function in production.
# During local Vite development, /api is proxied to VITE_LOCAL_AI_PROXY_URL.
VITE_GEMINI_PROXY_URL=/api
VITE_LOCAL_AI_PROXY_URL=http://127.0.0.1:8787
VITE_GEMINI_PROXY_API_KEY=

# Production database for Vercel. Use a pooled Neon/Vercel Postgres connection string.
# In local development, leave empty unless you want to use Postgres instead of the local API.
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Instructor registration admin email notifications.
# Preferred production option: Resend. If RESEND_API_KEY is present, it is used before SMTP.
RESEND_API_KEY=
RESEND_FROM=LevelUP <onboarding@resend.dev>

# Gmail SMTP fallback. For Gmail, use an App Password, not your normal Gmail password.
LEVELUP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=LevelUp <your-sender@gmail.com>
LEVELUP_EMAIL_TEST_SECRET=change-this-test-secret
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=LevelUp <your-sender@gmail.com>
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LEVELUP_ENFORCE_EMAIL_VERIFICATION=false
# auto tries Resend first, then SMTP. Use smtp or resend to force one provider.
LEVELUP_OTP_EMAIL_PROVIDER=auto
