# PostgreSQL
DATABASE_URL=postgresql://levelup:replace-me@127.0.0.1:5432/levelup
# Must be a separate database or a separate Supabase project. Never reuse DATABASE_URL.
DATABASE_URL_TEST=postgresql://levelup:replace-me@127.0.0.1:5432/levelup_test
# Keep this low for serverless deployments. The default is 5.
DATABASE_POOL_MAX=5

# Server-only secrets
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
APP_URL=http://localhost:3000
# Extra hostnames or LAN IPs permitted to load Next.js development assets.
# Separate multiple values with commas. The current review network is already allowed by next.config.ts.
LEVELUP_DEV_ORIGINS=
CRON_SECRET=replace-with-a-random-32-character-minimum-cron-secret

# Google OAuth. Add both values from Google Cloud before enabling the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authentication delivery. Development mode shows the OTP only in the local sign-in flow.
OTP_PROVIDER=development
OTP_SENDER_ID=LevelUp
# Set OTP_PROVIDER=infobip for real SMS delivery, then provide these values.
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=replace-with-an-infobip-api-key
# Set OTP_PROVIDER=meta_whatsapp to send OTPs with an approved Meta WhatsApp
# authentication template. These values are all server-only.
META_WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-access-token
META_WHATSAPP_GRAPH_API_VERSION=vXX.X
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-the-meta-phone-number-id
META_WHATSAPP_TEMPLATE_NAME=levelup_verification
META_WHATSAPP_TEMPLATE_LANGUAGE=ar

# Email verification for new email/password accounts.
# Keep development locally until a Resend sender domain and API key are configured.
# In production, either this provider or OTP_PROVIDER must be a real provider.
EMAIL_OTP_PROVIDER=development
RESEND_API_KEY=replace-with-a-resend-api-key
RESEND_FROM=LevelUp <verify@your-domain.example>

# Object storage for teacher profile photos and future uploads.
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BUCKET=levelup-media
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
